{
  "name": "Watchpost Guardian",
  "short_name": "Guardian",
  "description": "Check a suspicious text, link or screenshot for scam tactics. Share it straight to Guardian; it's read on your phone.",
  "start_url": "/guardian/",
  "display": "standalone",
  "background_color": "#F1F6F9",
  "theme_color": "#155F87",
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/guardian/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}